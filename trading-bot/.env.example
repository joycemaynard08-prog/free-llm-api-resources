# Alpaca API credentials
# Get these from https://alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Trading mode: "paper" or "live"
# Paper uses https://paper-api.alpaca.markets
# Live uses https://api.alpaca.markets
TRADING_MODE=paper

# Comma-separated list of stock symbols to trade
STOCK_SYMBOLS=AAPL,MSFT,SPY

# Comma-separated list of crypto pairs to trade
CRYPTO_SYMBOLS=BTC/USD,ETH/USD

# Moving average periods (in bars)
SHORT_WINDOW=20
LONG_WINDOW=50

# Maximum position size as a fraction of portfolio (0.1 = 10%)
MAX_POSITION_SIZE=0.1

# Bar timeframe: 1Min, 5Min, 15Min, 1Hour, 1Day
TIMEFRAME=1Hour

# How many bars of historical data to load on startup
LOOKBACK_BARS=200
